  m_Script: {fileID: 11500000, guid: 6ab8852b8a15b1f449cc67d6710b4b30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RadioSystem
  radioMessageUI: {fileID: 1958910407}
  transmissions:
  - audio: {fileID: 8300000, guid: b0973dc3788292942823d967664bc5bb, type: 3}
    message: "Alguns objetos s\xF3 podem ser encontrados atrav\xE9s da c\xE2mera.
      Fique atento."
  - audio: {fileID: 8300000, guid: b0973dc3788292942823d967664bc5bb, type: 3}
    message: "A bateria da c\xE2mera diminui enquanto ela estiver aberta. Use-a com
      cuidado."
  - audio: {fileID: 8300000, guid: b0973dc3788292942823d967664bc5bb, type: 3}
    message: "Voc\xEA pode visualizar suas fotos no \xE1lbum de fotos pressionando
      o bot\xE3o direito do mouse"
  - audio: {fileID: 8300000, guid: b0973dc3788292942823d967664bc5bb, type: 3}
    message: "Explore o mapa e procure por baterias. Voc\xEA vai precisar delas"
  - audio: {fileID: 8300000, guid: b0973dc3788292942823d967664bc5bb, type: 3}
    message: "A bateria da c\xE2mera diminui enquanto ela estiver aberta. Use-a com
      cuidado."
  - audio: {fileID: 8300000, guid: b0973dc3788292942823d967664bc5bb, type: 3}
    message: "Algumas pistas podem aparecer somente quando observadas pela c\xE2mera"
  minInterval: 35
  maxInterval: 40
  playOnStart: 1
