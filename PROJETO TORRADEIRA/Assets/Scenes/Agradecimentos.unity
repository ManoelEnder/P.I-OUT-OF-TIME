  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70>OUT OF TIME</size>\n<color=#8C8C88>LAB 1975  //  FITA FINAL</color>\n\n\n<size=40>OBRIGADO
    POR JOGAR</size>\n\n<color=#8C8C88>A primeira c\xE2mera digital foi montada em
    1975, num laborat\xF3rio da Kodak.\nNesta fita, voc\xEA trouxe ela de volta.</color>\n\n\n\n\n<color=#D23A32>EQUIPE</color>\n\nMANOEL
    SCHEIDT ENDER\n<color=#8C8C88>Programador e Game Designer</color>\n\nJ\xDALLYA
    DIELLY MARTINS MONTEIRO\n<color=#8C8C88>Programadora e Game Designer</color>\n\nGABRIEL
    PAMPLONA\n<color=#8C8C88>Sonoplasta e Programador</color>\n\n\n\n\n<color=#D23A32>PROJETO
    INTEGRADOR</color>\n\nJogo desenvolvido como Projeto Integrador\n<color=#8C8C88>Senac
    Santa Catarina</color>\n\nInspirado na hist\xF3ria real de Steven Sasson\ne do
    prot\xF3tipo de c\xE2mera digital da Kodak (1975)\n\n\n\n\n<color=#D23A32>MODELOS
    3D E CEN\xC1RIOS</color>\n\nAbandoned Office\nFacility-7 Genetics\nPSX Nostalgia
    (Computer Set)\nPSX Mega Pack (Sample)\nCaution Tape\nBathroom Cleaning Props
    Set (Low Poly)\nDetective's Office in Noir Style\nIsometric Office\nWomen in
    Trades in the Classroom: School Lab\nLow Poly Household Items\nFurniture Pack\nJustPlay:
    Furniture Used Set\nAbandoned World: Wood Box Free\n\n<color=#8C8C88>Todos os
    direitos aos seus respectivos autores.</color>\n\n\n\n\n<color=#D23A32>INTERFACE
    E FERRAMENTAS</color>\n\nKenney: Fantasy UI Borders\nVCR OSD Mono (fonte)\nQuick
    Outline\nEasy Collider Editor\n\n\n\n\n<color=#D23A32>M\xDASICA E SONS</color>\n\nCasual
    & Relaxing Game Music\nEfeito de detector de metais (Depositphotos)\nEfeitos
    da cutscene e ambiente do laborat\xF3rio\n\n<color=#8C8C88>Grito, est\xE1tica,
    passos, bipes, servo da garra e\noutros efeitos sintetizados no pr\xF3prio jogo</color>\n\n\n\n\n<color=#D23A32>FEITO
    COM</color>\n\nUnity 6  \xB7  Universal Render Pipeline  \xB7  Cinemachine\nBlender\nRemotion
    (cutscenes)\n\n\n\n\n\n\n<size=40>FIM DA GRAVA\xC7\xC3O</size>\n\n<color=#8C8C88>[ESC]
    voltar ao menu</color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4a4a2da3efba7af46bc2f16999f20ea3, type: 2}
